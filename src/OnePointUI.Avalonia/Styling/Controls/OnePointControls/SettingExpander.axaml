<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OnePointUI.Avalonia.Styling.Controls.OnePointControls"
        xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items">
    <Design.PreviewWith>
        <StackPanel Width="420" Margin="10" Spacing="10">
            <controls:SettingExpander Header="展开器"
                                      Glyph="&#xEB9F;"
                                      Description="点击展开下方的设置项"
                                      IsExpanded="True"
                                      RightContent="3 项">
                <StackPanel>
                    <controls:SettingCard Header="子设置项"
                                          Glyph="&#xE71E;"
                                          Description="说明文字" />
                    <controls:SettingCard Header="可点击子项"
                                          Glyph="&#xE71E;"
                                          Description="aaa"
                                          IsClickable="True" />
                    <controls:SettingCard Header="图片图标"
                                          IsFontIcon="False"
                                          ImageIcon="../../../Assets/OnePointUI.Icon.png" />
                </StackPanel>
            </controls:SettingExpander>

            <controls:SettingExpander Header="默认收起"
                                      Glyph="&#xEB9F;" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|SettingExpander">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate>
                <items:BorderCard
                    ClipToBounds="True"
                    Padding="0"
                    MinHeight="{TemplateBinding MinHeight}"
                    Name="PART_RootCard">
                    <Grid Margin="1" RowDefinitions="Auto,Auto">

                        <Border Name="PART_Header"
                                Focusable="True"
                                Background="Transparent">
                            <Panel>
                                <Border Name="PATH_HeaderBackground"
                                        IsHitTestVisible="False"
                                        CornerRadius="6"
                                        Background="{DynamicResource MouseHighlightColor}"
                                        Opacity="0" />

                                <Border Padding="8,12,8,12">
                                    <Grid>
                                        <controls:FontIcon Glyph="{TemplateBinding Glyph}"
                                                           FontSize="24"
                                                           Margin="10,0,0,0"
                                                           IsVisible="{TemplateBinding IsFontIcon}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />

                                        <Border Width="32" Height="32"
                                                CornerRadius="4"
                                                Margin="5,0,0,0"
                                                IsVisible="{TemplateBinding IsNotFontIcon}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                ClipToBounds="True">
                                            <Image Width="32" Height="32"
                                                   Stretch="UniformToFill"
                                                   Source="{TemplateBinding ImageIcon}" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="50,0,0,0">
                                            <ContentPresenter Content="{TemplateBinding Header}">
                                                <ContentPresenter.Styles>
                                                    <Style Selector="TextBlock">
                                                        <Setter Property="FontSize"
                                                                Value="16" />
                                                    </Style>
                                                </ContentPresenter.Styles>
                                            </ContentPresenter>

                                            <ContentPresenter Content="{TemplateBinding Description}">
                                                <ContentPresenter.Styles>
                                                    <Style Selector="TextBlock">
                                                        <Setter Property="FontSize"
                                                                Value="11" />
                                                        <Setter Property="Foreground"
                                                                Value="Gray" />
                                                    </Style>
                                                </ContentPresenter.Styles>
                                            </ContentPresenter>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <ContentControl Name="ActionContentControl"
                                                            Content="{TemplateBinding RightContent}"
                                                            Margin="0,0,12,0" />

                                            <controls:FontIcon Name="PART_Chevron"
                                                               Glyph="&#xE70D;"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"
                                                               FontSize="16" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Panel>
                        </Border>

                        <Border Grid.Row="1"
                                Name="PART_ContentClip"
                                Height="0"
                                CornerRadius="0,0,6,6"
                                Background="Transparent"
                                ClipToBounds="True">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                    </Grid>
                </items:BorderCard>
            </ControlTemplate>
        </Setter>

        <!-- 悬停高亮（只作用于头部区域） -->
        <Style Selector="^ /template/ Border#PATH_HeaderBackground">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^ /template/ Border#PART_Header:pointerover Border#PATH_HeaderBackground">
            <Setter Property="Opacity" Value="0.25" />
        </Style>

        <!-- 展开时头部高亮与下方内容连通，底部改为直角 -->
        <Style Selector="^[IsExpanded=True] /template/ Border#PATH_HeaderBackground">
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>

        <!-- 箭头旋转 -->
        <Style Selector="^ /template/ controls|FontIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.2"
                                                   Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[IsExpanded=True] /template/ controls|FontIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(-180deg)" />
        </Style>

        <!-- 内容淡入淡出 -->
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.2"
                                      Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[IsExpanded=True] /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Style>

    <!--
        SettingExpander 内的 SettingCard 自适应样式。
        通过后代选择器自动命中展开器中的所有 SettingCard（不使用 Classes）：
        去掉独立卡片外观，改为通栏行 + 顶部分隔线，与展开器融为一体。
        声明在 SettingCard.axaml 之后，样式按顺序覆盖原模板。
    -->
    <Style Selector="controls|SettingExpander controls|SettingCard">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="Transparent">
                    <Panel>
                        <Border Name="PATH_Background"
                                IsHitTestVisible="False"
                                IsVisible="{TemplateBinding IsClickable}"
                                Background="{DynamicResource MouseHighlightColor}"
                                Opacity="0" />

                        <Border Name="PATH_Divider"
                                Height="1"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Background="{DynamicResource GeneralBorderBrush}"
                                Opacity="{DynamicResource GeneralBorderBrushOpacity}" />

                        <Border Padding="8,12,8,12">
                            <Grid>
                                <controls:FontIcon Glyph="{TemplateBinding Glyph}"
                                                   FontSize="16"
                                                   Margin="10,0,0,0"
                                                   IsVisible="{TemplateBinding IsFontIcon}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />

                                <Image Width="24" Height="24"
                                       Stretch="UniformToFill"
                                       Margin="7,0,0,0"
                                       IsVisible="{TemplateBinding IsNotFontIcon}"
                                       Source="{TemplateBinding ImageIcon}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />

                                <StackPanel VerticalAlignment="Center"
                                            Margin="50,0,0,0">
                                    <ContentPresenter Content="{TemplateBinding Header}">
                                        <ContentPresenter.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize"
                                                        Value="14" />
                                            </Style>
                                        </ContentPresenter.Styles>
                                    </ContentPresenter>

                                    <ContentPresenter Content="{TemplateBinding Description}">
                                        <ContentPresenter.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize"
                                                        Value="11" />
                                                <Setter Property="Foreground"
                                                        Value="Gray" />
                                            </Style>
                                        </ContentPresenter.Styles>
                                    </ContentPresenter>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <ContentControl Name="ActionContentControl"
                                                    Content="{TemplateBinding Content}"
                                                    Margin="0,0,6,0" />

                                    <Border IsVisible="{TemplateBinding IsShowActionIcon}">
                                        <controls:FontIcon Glyph="&#xE974;"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"
                                                           IsVisible="{TemplateBinding IsClickable}"
                                                           FontSize="14" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PATH_Background">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
    </Style>
    
    <Style Selector="controls|SettingExpander controls|SettingCard.People">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="Transparent">
                    <Panel>
                        <Border Name="PATH_Background"
                                IsHitTestVisible="False"
                                IsVisible="{TemplateBinding IsClickable}"
                                Background="{DynamicResource MouseHighlightColor}"
                                Opacity="0" />

                        <Border Name="PATH_Divider"
                                Height="1"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Background="{DynamicResource GeneralBorderBrush}"
                                Opacity="{DynamicResource GeneralBorderBrushOpacity}" />
                        
                        <Border VerticalAlignment="Stretch" 
                                HorizontalAlignment="Left">
                            <Grid>
                                <Image Width="125"
                                       Height="60"
                                       Opacity="0.8"
                                       Margin="-16,0,0,0"
                                       Stretch="UniformToFill"
                                       Source="{TemplateBinding ImageIcon}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch">
                                    <Image.OpacityMask>
                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                            <GradientStop Color="Black" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Image.OpacityMask>
                                </Image>
                            </Grid>
                            
                        </Border>

                        <Border Padding="8,12,8,12">
                            <Grid>
                                <controls:FontIcon Glyph="{TemplateBinding Glyph}"
                                                   FontSize="16"
                                                   Margin="10,0,0,0"
                                                   IsVisible="{TemplateBinding IsFontIcon}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />

                                <StackPanel VerticalAlignment="Center"
                                            Margin="50,0,0,0">
                                    <ContentPresenter Content="{TemplateBinding Header}">
                                        <ContentPresenter.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize"
                                                        Value="14" />
                                                <Setter Property="Foreground"
                                                        Value="White" />
                                            </Style>
                                        </ContentPresenter.Styles>
                                    </ContentPresenter>

                                    <ContentPresenter Content="{TemplateBinding Description}">
                                        <ContentPresenter.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize"
                                                        Value="11" />
                                                <Setter Property="Foreground"
                                                        Value="White" />
                                            </Style>
                                        </ContentPresenter.Styles>
                                    </ContentPresenter>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <ContentControl Name="ActionContentControl"
                                                    Content="{TemplateBinding Content}"
                                                    Margin="0,0,6,0" />

                                    <Border IsVisible="{TemplateBinding IsShowActionIcon}">
                                        <controls:FontIcon Glyph="&#xE974;"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"
                                                           IsVisible="{TemplateBinding IsClickable}"
                                                           FontSize="14" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PATH_Background">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
    </Style>
</Styles>
