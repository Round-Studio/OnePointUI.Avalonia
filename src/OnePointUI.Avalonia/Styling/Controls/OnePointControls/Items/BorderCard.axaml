<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items">
    <Design.PreviewWith>
        <controls:BorderCard />
    </Design.PreviewWith>

    <Style Selector="controls|BorderCard">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource GeneralBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource GeneralBorderBrush}" />
        <Setter Property="BorderOpacity" Value="{DynamicResource GeneralBorderBrushOpacity}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="{TemplateBinding BorderOpacity}" />

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="{TemplateBinding InnerMargin}"
                            Opacity="{TemplateBinding BorderOpacity}" />

                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>